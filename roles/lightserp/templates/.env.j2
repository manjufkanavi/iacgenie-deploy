# LightSerp Environment Variables
# Managed by Ansible
DATABASE_URL=lightsrp@postgres:5432/lightsrp
MINIO_ENDPOINT={{ minio_api_host | default('127.0.0.1') }}:{{ minio_api_port | default(9000) }}
MINIO_ACCESS_KEY={{ minio_root_user | default('iacgenie') }}
MINIO_SECRET_KEY=*** minio_root_password | default('CHANGE_ME_IN_VAULT') }}
NSQD_ADDR={{ nsqd_host | default('127.0.0.1') }}:{{ nsqd_tcp_port | default(4150) }}
SearXNG_URL=http://searxng:8080
LIGHTSERP_API_SECRET=*** lightserp_api_secret | default('CHANGE_ME_IN_VAULT') }}
