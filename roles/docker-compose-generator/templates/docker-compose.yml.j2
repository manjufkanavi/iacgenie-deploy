# IacGenie Unified Infrastructure
# Generated by Ansible — do not edit manually
# Usage: cd /home/mkanavi/iacgenie-unified-infra && docker compose up -d
---
services:
  # =====================
  # PostgreSQL 15
  # =====================
  postgres:
    image: postgres:15-alpine
    container_name: iacgenie_postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: lightsrp
      POSTGRES_PASSWORD: "${PG_ROOT_PASSWORD}"
      POSTGRES_DB: lightsrp
    volumes:
      - postgres_data:/var/lib/postgresql/data
    ports:
      - "127.0.0.1:5432:5432"
    networks:
      - "{{ docker_network_name | default('iacgenie-network') }}"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U lightsrp -d lightsrp"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.postgres }}"

  # =====================
  # Redis 7
  # =====================
  redis:
    image: redis:7-alpine
    container_name: iacgenie_redis
    restart: unless-stopped
    command: redis-server --appendonly yes --maxmemory 2gb --maxmemory-policy allkeys-lru
    volumes:
      - redis_data:/data
    ports:
      - "127.0.0.1:6379:6379"
    networks:
      - "{{ docker_network_name | default('iacgenie-network') }}"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.redis }}"

  # =====================
  # MinIO
  # =====================
  minio:
    image: minio/minio:latest
    container_name: iacgenie_minio
    restart: unless-stopped
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: "{{ minio_root_user | default('iacgenie') }}"
      MINIO_ROOT_PASSWORD: "${MINIO_ROOT_PASSWORD}"
    volumes:
      - minio_data:/data
    ports:
      - "127.0.0.1:9000:9000"
      - "127.0.0.1:9001:9001"
    networks:
      - "{{ docker_network_name | default('iacgenie-network') }}"
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.minio }}"

  # =====================
  # OpenBao 2.6.0
  # =====================
  openbao:
    image: openbao/openbao:2.6.0
    container_name: iacgenie_openbao
    restart: unless-stopped
    environment:
      OPENBAO_ADDR: http://127.0.0.1:8200
      OPENBAO_CLUSTER_ADDR: https://127.0.0.1:8201
      OPENBAO_UI: "true"
      OPENBAO_STORAGE_TYPE: raft
      OPENBAO_STORAGE_PATH: /openbao/storage
      OPENBAO_LOG_LEVEL: info
    volumes:
      - openbao_data:/openbao/storage
      - openbao_raft:/openbao/raft
      - /etc/letsencrypt:/etc/letsencrypt
    ports:
      - "127.0.0.1:8200:8200"
      - "127.0.0.1:8201:8201"
    networks:
      - "{{ docker_network_name | default('iacgenie-network') }}"
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://127.0.0.1:8200/v1/sys/health | grep -q '\"sealed\":false'"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.openbao }}"

  # =====================
  # Keycloak 26.0
  # =====================
  keycloak:
    image: quay.io/keycloak/keycloak:26.0
    container_name: iacgenie_keycloak
    restart: unless-stopped
    command: start --hostname-keycloak --http-enabled=true --http-port=8080 --db=postgres --db-url-host=postgres --db-url-port=5432 --db-database=keycloak --db-username=keycloak --db-password="${KC_DB_PASSWORD}"
    environment:
      KC_BOOTSTRAP_ADMIN_USERNAME: "${KEYCLOAK_ADMIN_USER}"
      KC_BOOTSTRAP_ADMIN_PASSWORD: "${KEYCLOAK_ADMIN_PASSWORD}"
      KEYCLOAK_ADMIN: "${KEYCLOAK_ADMIN_USER}"
      KEYCLOAK_ADMIN_PASSWORD: "${KEYCLOAK_ADMIN_PASSWORD}"
      KC_DB: postgres
      KC_DB_URL_HOST: postgres
      KC_DB_URL_PORT: 5432
      KC_DB_DATABASE: keycloak
      KC_DB_USERNAME: keycloak
      KC_DB_PASSWORD: "${KC_DB_PASSWORD}"
      KC_HOSTNAME: auth.iacgenie.com
      KC_PROXY: edge
    volumes:
      - keycloak_data:/opt/keycloak/data
    ports:
      - "127.0.0.1:8080:8080"
    networks:
      - "{{ docker_network_name | default('iacgenie-network') }}"
    depends_on:
      - postgres
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://127.0.0.1:8080/health/ready || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.keycloak }}"

  # =====================
  # Gitea 1.23.4
  # =====================
  gitea:
    image: gitea/gitea:1.23.4-rootless
    container_name: iacgenie_gitea
    restart: unless-stopped
    environment:
      USER: root
      GITEA__database__DB_TYPE: postgres
      GITEA__database__HOST: postgres:5432
      GITEA__database__NAME: gitea
      GITEA__database__USER: gitea
      GITEA__database__PASSWORD: "${GITEA_DB_PASSWORD}"
      GITEA__security__INSTALL_LOCK: "true"
      GITEA__service__DISABLE_REGISTRATION: "false"
      GITEA__service__REGISTER_EMAIL_CONFIRM: "false"
      GITEA__service__ENABLE_NOTIFY_MAIL: "true"
      GITEA__mailer__ENABLED: "true"
      GITEA__mailer__SMTP_ADDR: "${SMTP_ADDR}"
      GITEA__mailer__SMTP_PORT: "${SMTP_PORT}"
      GITEA__mailer__USER: "${SMTP_USER}"
      GITEA__mailer__PASSWD: "${SMTP_PASS}"
      GITEA__mailer__FROM: "${SMTP_FROM}"
    volumes:
      - gitea_data:/var/lib/gitea
      - gitea_data:/etc/gitea
    ports:
      - "127.0.0.1:3000:3000"
      - "127.0.0.1:2222:2222"
    networks:
      - "{{ docker_network_name | default('iacgenie-network') }}"
    depends_on:
      - postgres
    healthcheck:
      test: ["CMD", "curl", "-f", "http://127.0.0.1:3000/"]
      interval: 30s
      timeout: 10s
      retries: 3
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.gitea }}"

  # =====================
  # LightSerp API
  # =====================
  lightserp-api:
    image: mkanavi/lightserp-api:latest
    container_name: iacgenie_lightserp_api
    restart: unless-stopped
    environment:
      DATABASE_URL: "lightsrp@postgres:5432/lightsrp"
      MINIO_ENDPOINT: "minio:9000"
      MINIO_ACCESS_KEY: "${MINIO_ROOT_USER}"
      MINIO_SECRET_KEY: "${MINIO_ROOT_PASSWORD}"
      NSQD_ADDR: "nsqd:4150"
      SEARXNG_URL: "http://searxng:8080"
      LIGHTSERP_S3_BASE: "iacgenie-lightserp"
      LIGHTSERP_ALLOW_INSECURE: "true"
    ports:
      - "127.0.0.1:8000:8000"
    networks:
      - "{{ docker_network_name | default('iacgenie-network') }}"
    depends_on:
      - postgres
      - minio
      - nsqd
      - searxng
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.lightserp }}"

  # =====================
  # LightSerp WebUI
  # =====================
  lightserp-webui:
    image: mkanavi/lightserp-webui:latest
    container_name: iacgenie_lightserp_webui
    restart: unless-stopped
    ports:
      - "127.0.0.1:3001:3001"
    networks:
      - "{{ docker_network_name | default('iacgenie-network') }}"
    depends_on:
      - lightserp-api
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.lightserp }}"

  # =====================
  # SearXNG
  # =====================
  searxng:
    image: searxng/searxng:latest
    container_name: iacgenie_searxng
    restart: unless-stopped
    environment:
      SEARXNG_SECRET: "${SEARXNG_SECRET_KEY}"
      SEARXNG_BASE_URL: "http://search.iacgenie.com"
    ports:
      - "127.0.0.1:8080:8080"
    networks:
      - "{{ docker_network_name | default('iacgenie-network') }}"
    deploy:
      resources:
        limits:
          memory: "512m"

  # =====================
  # NSQD
  # =====================
  nsqd:
    image: nsqio/nsq:latest
    container_name: iacgenie_nsqd
    restart: unless-stopped
    command: nsqd --tcp-address=0.0.0.0 --http-address=0.0.0.0 --data-path=/nsq/data
    volumes:
      - nsqd_data:/nsq/data
    ports:
      - "127.0.0.1:4150:4150"
      - "127.0.0.1:4151:4151"
    networks:
      - "{{ docker_network_name | default('iacgenie-network') }}"
    deploy:
      resources:
        limits:
          memory: "256m"

  # =====================
  # PageZen
  # =====================
  pagezen:
    image: mkanavi/pagezen:latest
    container_name: iacgenie_pagezen
    restart: unless-stopped
    environment:
      LIGHTSERP_API_URL: "http://lightserp-api:8000"
      LIGHTSERP_API_SECRET: "${LIGHTSERP_API_SECRET}"
    ports:
      - "127.0.0.1:8081:8081"
    networks:
      - "{{ docker_network_name | default('iacgenie-network') }}"
    depends_on:
      - lightserp-api
    deploy:
      resources:
        limits:
          memory: "{{ service_memory_defaults.pagezen }}"

# Volumes
volumes:
  postgres_data:
    driver: local
  redis_data:
    driver: local
  minio_data:
    driver: local
  openbao_data:
    driver: local
  openbao_raft:
    driver: local
  keycloak_data:
    driver: local
  gitea_data:
    driver: local
  nsqd_data:
    driver: local

# Networks
networks:
  "{{ docker_network_name | default('iacgenie-network') }}":
    external: false
    driver: bridge
    ipam:
      config:
        - subnet: "{{ docker_network_subnet | default('172.28.0.0/16') }}"
