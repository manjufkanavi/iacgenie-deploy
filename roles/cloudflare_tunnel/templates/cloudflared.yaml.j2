# Cloudflare Tunnel configuration
# Managed by Ansible
metrics: 0.0.0.0:{{ cloudflared_metrics_port | default(12345) }}
no-autoupdate: true

tunnels:
  - name: {{ cloudflared_tunnel_name | default('iacgenie-tunnel') }}
    credentials-file: /etc/cloudflared/{{ cloudflared_tunnel_name }}.json
    gracePeriod: 30s
    autoUpdateFrequency: 24h

    # Default route — catch-all
    hostname: iacgenie.com
    path: /
    service: http://nginx:80

    # Service rules — maps each subdomain to the correct Docker service
    serviceRules:
{% for domain, svc in cloudflared_services | default({
  'auth.iacgenie.com': 'http://keycloak:8080',
  'search.iacgenie.com': 'http://searxng:8080',
  'api.iacgenie.com': 'http://lightserp-api:8000',
  'app.iacgenie.com': 'http://lightserp-webui:3001',
  'git.iacgenie.com': 'http://gitea:3000',
  'page.iacgenie.com': 'http://pagezen:8081'
}) | items %}
      - hostname: {{ domain }}
        service: {{ svc }}
{% endfor %}
