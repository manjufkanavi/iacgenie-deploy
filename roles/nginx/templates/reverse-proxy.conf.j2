# Nginx reverse proxy for IacGenie services
# Managed by Ansible

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{ wildcard_domains[0] | replace('*', 'auth') if wildcard_domains else 'auth.iacgenie.com' }};

    ssl_certificate /etc/letsencrypt/live/{{ wildcard_domains[0] | replace('*', 'auth') }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ wildcard_domains[0] | replace('*', 'auth') }}/privkey.pem;

    location / {
        proxy_pass http://keycloak:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

