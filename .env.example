# IacGenie Environment Variables Template
# Copy to .env and fill in real values
# IMPORTANT: Never commit .env to git - it's in .gitignore
# Store sensitive values in Ansible Vault instead

# =====================
# PostgreSQL
# =====================
PG_ROOT_PASSWORD=CHANGE_ME_IN_VAULT
PG_POSTGRES_PASSWORD=CHANGE_ME_IN_VAULT
PG_DATABASE=iacgenie
PG_USER=iacgenie
PG_PASSWORD=CHANGE_ME_IN_VAULT

# =====================
# Redis
# =====================
REDIS_PASSWORD=CHANGE_ME_IN_VAULT

# =====================
# MinIO
# =====================
MINIO_ROOT_USER=iacgenie
MINIO_ROOT_PASSWORD=CHANGE_ME_IN_VAULT

# =====================
# OpenBao
# =====================
OPENBAO_ROOT_TOKEN=CHANGE_ME_IN_VAULT
OPENBAO_ADDR=https://vault.iacgenie.com:8200

# =====================
# Keycloak
# =====================
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_IN_VAULT
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://127.0.0.1:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=CHANGE_ME_IN_VAULT

# =====================
# Gitea
# =====================
GITEA_ADMIN_USERNAME=admin
GITEA_ADMIN_PASSWORD=CHANGE_ME_IN_VAULT
GITEA_ADMIN_EMAIL=admin@iacgenie.com
GITEA_DB_HOST=127.0.0.1
GITEA_DB_PORT=5432
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASS=CHANGE_ME_IN_VAULT

# =====================
# LightSerp
# =====================
LIGHTSERP_API_SECRET=CHANGE_ME_IN_VAULT
LIGHTSERP_DATABASE_URL=lightsrp@127.0.0.1:5432/lightsrp
LIGHTSERP_MINIO_URL=http://127.0.0.1:9000
LIGHTSERP_MINIO_ACCESS_KEY=iacgenie
LIGHTSERP_MINIO_SECRET_KEY=CHANGE_ME_IN_VAULT
LIGHTSERP_SEARXNG_URL=http://127.0.0.1:8080
LIGHTSERP_NSQD_ADDR=127.0.0.1:4150
LIGHTSERP_KEYCLOAK_URL=http://127.0.0.1:8080
LIGHTSERP_KEYCLOAK_REALM=iag
LIGHTSERP_KEYCLOAK_CLIENT_ID=lightserp
LIGHTSERP_KEYCLOAK_CLIENT_SECRET=CHANGE_ME_IN_VAULT

# =====================
# SearXNG
# =====================
SEARXNG_SECRET_KEY=CHANGE_ME_IN_VAULT

# =====================
# Cloudflare
# =====================
CLOUDFLARE_API_TOKEN=CHANGE_ME_IN_VAULT

# =====================
# SMTP
# =====================
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USERNAME=CHANGE_ME_IN_VAULT
SMTP_PASSWORD=CHANGE_ME_IN_VAULT
SMTP_FROM=noreply@iacgenie.com

# =====================
# Backup
# =====================
RCLONE_CONFIG_GDRIVE_TYPE=drive
RCLONE_CONFIG_GDRIVE_SCOPE=drive
RCLONE_CONFIG_GDRIVE_TOKEN=CHANGE_ME_IN_VAULT

# =====================
# Certbot
# =====================
CERTBOT_EMAIL=admin@iacgenie.com
